# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins
FRONTEND_ORIGIN=http://localhost:3000

# Database (PostgreSQL — mandatory. SQLite is not supported.)
# Local development: docker compose up -d postgres (host port 5435 by default;
# change to 5432 if no native PostgreSQL occupies it on your machine)
DATABASE_URL="postgresql://gh_events:gh_events_dev@localhost:5435/gh_events?schema=public"

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN_HOURS=12
SCANNER_TOKEN_DAYS=7

# QR credentials
QR_CODE_PREFIX=GHAB1

# Email (Resend — https://resend.com). When RESEND_API_KEY is empty, emails
# are written to .data/outbox instead of sent (dev fallback).
RESEND_API_KEY=
# Verified Resend sender, e.g. "Government House Events <no-reply@ghab.gov.ag>"
EMAIL_FROM=

# Offline snapshot signing key (HMAC)
SNAPSHOT_SECRET=change-me

# Key used to encrypt credential codes at rest (AES-256-GCM)
CREDENTIAL_SECRET=change-me-to-a-long-random-string
